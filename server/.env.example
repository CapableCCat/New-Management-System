# ============================================================
# OSC 社团管理系统 · 后端环境变量样例（osc-server）
# 用法：复制本文件为 server/.env 并填入真实值。
#       .env 已被根 .gitignore 忽略 —— 任何明文密码都不许入仓。
# 生效方式：application.yml 中 spring.config.import=optional:file:./.env[.properties]
#          （工作目录为 server/ 时自动读取 server/.env）
# ============================================================

# ---------- 应用 ----------
# 端口：dev 默认 8080 / prod 默认 8081（在 application-dev|prod.yml 里各自兜底）
APP_PORT=8080
# 环境标识：默认 dev（application.yml 已兜底），prod 部署时由启动脚本/系统环境变量指定
# 注意：不在此处设置 SPRING_PROFILES_ACTIVE，避免与配置文件加载顺序产生歧义
# SPRING_PROFILES_ACTIVE=prod

# ---------- MySQL ----------
# T2 建好 osc 库与专属账号后填入真实值；应用一律不用 root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=osc
MYSQL_USER=osc_app
MYSQL_PASSWORD=

# ---------- Redis ----------
# 本机开发用的 Windows 版 Redis 无密码，REDIS_PASSWORD 留空即可
# （application-dev.yml 中未声明 password 项，避免空串触发 AUTH）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Sa-Token ----------
SA_TOKEN_NAME=osc-token
# token 有效期（秒）：2592000 = 30 天
SA_TOKEN_TIMEOUT=2592000

# ---------- MinIO（T11 启用，当前不生效）----------
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=osc
